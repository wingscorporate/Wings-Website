# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SERVICE_ACCOUNT_JSON: Full JSON credentials string for Google Sheets integration.
# Add via AI Studio Settings -> Secrets.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Public HTTPS URL of the Node backend route (not the Apps Script URL).
# GitHub Pages needs this at build time; same-origin Node hosting uses /api/careers/applications.
VITE_CAREERS_API_URL=

# Server-only: Apps Script deployment /exec URL and matching Script Property secret.
# Never prefix these with VITE_ or commit live values.
CAREERS_APPS_SCRIPT_URL=
CAREERS_APPS_SCRIPT_SECRET=
# Exact frontend origins, comma-separated. For Pages, normally:
CAREERS_ALLOWED_ORIGINS=https://wingscorporate.github.io
# Set only if the API is behind a known trusted reverse proxy (for example 1).
CAREERS_TRUST_PROXY_HOPS=0
